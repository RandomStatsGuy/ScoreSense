# Nginx reverse proxy for ScoreSense on a VPS.
#
# 1. Copy to the server (adjust paths):
#      sudo cp deploy/nginx/scoresense.conf.example /etc/nginx/sites-available/scoresense
# 2. Replace YOUR_DOMAIN.com with your real domain.
# 3. Enable and reload:
#      sudo ln -sf /etc/nginx/sites-available/scoresense /etc/nginx/sites-enabled/scoresense
#      sudo nginx -t && sudo systemctl reload nginx
# 4. TLS (first time):
#      sudo certbot --nginx -d YOUR_DOMAIN.com
#
# ScoreSense Docker must bind 127.0.0.1:8000 (see deploy/docker-compose.prod.yml).

upstream scoresense_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN.com;

    # Before TLS: proxy HTTP (needed for first deploy + certbot).
    # After certbot --nginx -d YOUR_DOMAIN.com, certbot adds HTTPS and redirect.
    location /api/hub/ws/ {
        proxy_pass http://scoresense_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://scoresense_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

# certbot --nginx adds a second server {} block for 443 with ssl_certificate paths.
# If configuring TLS manually, uncomment and fill paths below:
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name YOUR_DOMAIN.com;
#     ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN.com/privkey.pem;
#     ... same location blocks as port 80 ...
# }
