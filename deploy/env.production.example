# Production .env for VPS — copy to repo root as .env on the server:
#   cp deploy/env.production.example .env
#
# Production example: Fourth Down Labs company domain, ScoreSense on app subdomain.
# Cloudflare Tunnel: point app.fourthdownlabs.com → http://127.0.0.1:8000

# --- Required for public Patreon hosting ---
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=[REDACTED]
PATREON_CAMPAIGN_ID=
PATREON_MIN_CENTS=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=[REDACTED]
FRONTEND_URL=[REDACTED]
AUTH_REQUIRED=true
HUB_AUTH_REQUIRED=true
# Optional read-only demo league UUID for logged-out Hub exploration
HUB_DEMO_LEAGUE_ID=
JWT_SECRET=
JWT_DAYS=14

# --- Transactional email (invites, verification, password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fourthdownlabs.com
SMTP_TLS=true

# --- Legal (external URLs) ---
# Legal — defaults to in-app /terms and /privacy (see src/config.py + FRONTEND_URL)
# TERMS_URL=[REDACTED]/terms
# PRIVACY_URL=[REDACTED]/privacy
TERMS_VERSION=2026-06

PYTHONPATH=.

# --- Android TWA (Play Store) — SHA-256 from Bubblewrap keystore ---
# TWA_SHA256_FINGERPRINT=AA:BB:CC:...
# TWA_PACKAGE_NAME=com.fourthdownlabs.scoresense

# --- Optional product APIs ---
FANTASYPROS_API_KEY=
FANTASYPROS_USE_AS_FEATURE=false
ODDS_API_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
