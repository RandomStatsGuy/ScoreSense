# Copy to .env for local/docker production

# Patreon OAuth (https://www.patreon.com/portal/registration/register-clients)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=https://yourdomain.com/api/auth/patreon/callback
PATREON_CAMPAIGN_ID=
PATREON_MIN_CENTS=100

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

FRONTEND_URL=https://yourdomain.com

# Set true when hosting for subscribers (locks entire site behind login)
AUTH_REQUIRED=false

# Draft Hub requires a ScoreSense account even when AUTH_REQUIRED=false (recommended)
HUB_AUTH_REQUIRED=true

# Transactional email (league invites, verification, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Legal pages (external URLs)
# Legal — in-app pages at /terms and /privacy (override to host elsewhere if needed)
# TERMS_URL=https://app.fourthdownlabs.com/terms
# PRIVACY_URL=https://app.fourthdownlabs.com/privacy
TERMS_VERSION=2026-09

# Comma-separated emails allowed to use /api/admin and the Admin portal UI
ADMIN_EMAILS=

# User bug reports → SCORE Jira (server-side only; never expose the token)
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=https://scoresenseapp.atlassian.net
JIRA_CLOUD_ID=3ca7af20-a021-4266-911e-860fd82cc42c
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCORE
JIRA_BUG_ISSUE_TYPE=Bug

# Log slow Draft Hub route phase timings + X-Hub-Timing-MS response header
HUB_TIMING=false

# Random secret for JWT signing — required outside pytest (openssl rand -hex 32)
JWT_SECRET=
JWT_DAYS=14

PYTHONPATH=.

# FantasyPros API (https://secure.fantasypros.com/api-keys) — never commit the real key
FANTASYPROS_API_KEY=
# Keep false for fair "ScoreSense vs FP" accuracy benchmarks (no FP leakage into model)
FANTASYPROS_USE_AS_FEATURE=false

# The Odds API (https://the-odds-api.com/) — NFL player props for Prop scan
ODDS_API_KEY=

# FanDuel DFS (optional) — copy X-Auth-Token from browser after logging into FanDuel DFS
FANDUEL_AUTH_TOKEN=
# Optional Basic auth client id (Authorization header) if required by your session
FANDUEL_AUTHORIZATION=

# YouTube Data API (https://console.cloud.google.com/) — team channel ingest for sentiment
YOUTUBE_API_KEY=

# Optional — AI beat summaries in Draft Hub live room (gpt-4o-mini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# BEAT_DIGEST_LLM_ENABLED=true
# BEAT_DIGEST_LLM_TOP_N=40
# BEAT_DIGEST_PREWARM_TOP_N=200
# Include fan-tier channels in sentiment aggregates (default false)
SENTIMENT_INCLUDE_FAN=false
# Default lookback when fetching uploads (days)
SENTIMENT_LOOKBACK_DAYS=14
